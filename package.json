{
  "name": "ts-lib-starter-kit",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@12.16.1",
  "description": "A modern TypeScript library starter with an ESM-first build, ESLint, Vitest, Conventional Commits, automated releases, and automatic spell-checking for everything",
  "author": "Mori <itsmori@tutamail.com>",
  "license": "MIT",
  "homepage": "https://github.com/mohammadGh/ts-lib-starter-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammadGh/ts-lib-starter-kit.git"
  },
  "bugs": "https://github.com/mohammadGh/ts-lib-starter-kit/issues",
  "keywords": [
    "typescript",
    "eslint",
    "lib starter",
    "library",
    "commitizen",
    "husky",
    "conventional-changelog",
    "conventional-commits",
    "release-it",
    "cspell",
    "rust-based build",
    "tsdown"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "cz": "cz",
    "commit": "cz",
    "release": "release-it",
    "spell": "cspell ."
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@antfu/ni": "catalog:tooling",
    "@antfu/utils": "catalog:tooling",
    "@arethetypeswrong/core": "catalog:build",
    "@commitlint/cli": "catalog:commit",
    "@commitlint/config-conventional": "catalog:commit",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:test",
    "changelogen": "catalog:release",
    "commitizen": "catalog:commit",
    "cspell": "catalog:lint",
    "cz-conventional-changelog": "catalog:commit",
    "eslint": "catalog:lint",
    "eslint-plugin-slop": "catalog:lint",
    "eslint-plugin-sonarjs": "catalog:lint",
    "husky": "catalog:commit",
    "lint-staged": "catalog:commit",
    "pnpm": "catalog:tooling",
    "publint": "catalog:build",
    "release-it": "catalog:release",
    "release-it-beautiful-changelog": "catalog:release",
    "tsdown": "catalog:build",
    "tsdown-stale-guard": "catalog:build",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  },
  "lint-staged": {
    "*.*": "eslint --fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
