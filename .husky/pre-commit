#!/usr/bin/env sh
set -eu

# lint only staged files
if git diff --cached --name-only --diff-filter=ACMR; then
  pnpm lint-staged
  git update-index --again
else
  echo "No staged code files; skipping lint-staged."
fi

# run spell checker for staged files
git diff --cached --name-only --diff-filter=ACMR -z \
  | xargs -0 -r pnpm cspell \
      --no-summary \
      --no-progress \
      --no-must-find-files
